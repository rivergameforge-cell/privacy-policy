{
  "hosting": {
    "site": "v8redline-studio",
    "public": ".hosting-public",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/v8redline.html",
        "type": 302
      },
      {
        "source": "/privacy-policy",
        "destination": "/v8redline.html",
        "type": 302
      },
      {
        "source": "/privacy-policy/:path*",
        "destination": "/:path",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  }
}
